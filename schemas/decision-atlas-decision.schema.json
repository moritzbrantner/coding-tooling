{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moritzbrantner/coding-tooling/blob/main/schemas/decision-atlas-decision.schema.json",
  "title": "Decision Atlas indexed Decision or Question (index schemaVersion 1 and 2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "aliases",
    "parentId",
    "path",
    "choice",
    "statement",
    "decisionStatus",
    "implementation",
    "tags",
    "relations",
    "links",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque stable ID: never renumber or rewrite."
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parentId": {
      "type": ["string", "null"]
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "choice": {
      "type": ["string", "null"]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "description": "Current authored Markdown text. Strike-through preserves retired wording; a replacement follows it inline."
    },
    "decisionStatus": {
      "type": ["string", "null"],
      "enum": ["accepted", "recorded", "proposed", "superseded", null],
      "description": "Superseded means the authored decision has no remaining active wording."
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLabel", "verification"],
      "properties": {
        "sourceLabel": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "const": "unverified"
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "links": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "kind": {
      "enum": ["decision", "question"]
    },
    "evidence": {
      "type": "array",
      "description": "Binary implementation evidence children authored as `- [x] <text>` / `- [ ] <text>` under a Decision, in authored order. Present on every entry in schemaVersion 2 indexes and absent from schemaVersion 1 indexes. Empty for Questions and unaudited Decisions. A checked item covers only its own stated behavior and never verifies the parent Decision; progress (completed/total) is derived and not stored.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "checked"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed authored Markdown after the checkbox marker; unique within its Decision."
          },
          "checked": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "question"
          }
        }
      },
      "then": {
        "properties": {
          "decisionStatus": {
            "const": null
          },
          "choice": {
            "const": null
          },
          "evidence": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "properties": {
          "decisionStatus": {
            "enum": ["accepted", "recorded", "proposed", "superseded"]
          }
        }
      }
    }
  ]
}
