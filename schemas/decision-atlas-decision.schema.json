{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moritzbrantner/coding-tooling/blob/main/schemas/decision-atlas-decision.schema.json",
  "title": "Decision Atlas indexed Decision or Question (index schemaVersion 1 and 2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "aliases",
    "parentId",
    "path",
    "choice",
    "statement",
    "decisionStatus",
    "implementation",
    "tags",
    "relations",
    "links",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque stable ID: never renumber or rewrite."
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parentId": {
      "type": ["string", "null"]
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "choice": {
      "type": ["string", "null"]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "description": "Current authored Markdown text. Strike-through preserves retired wording; a replacement follows it inline."
    },
    "decisionStatus": {
      "type": ["string", "null"],
      "enum": ["accepted", "recorded", "proposed", "superseded", null],
      "description": "Superseded means the authored decision has no remaining active wording."
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLabel", "verification"],
      "properties": {
        "sourceLabel": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "const": "unverified"
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "links": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "kind": {
      "enum": ["decision", "question"]
    },
    "evidence": {
      "type": "array",
      "description": "Binary implementation evidence children authored as `- [x] <text>` / `- [ ] <text>` under a Decision, in authored order. Present on every entry in schemaVersion 2 indexes and absent from schemaVersion 1 indexes. Empty for Questions and unaudited Decisions. A checked item covers only its own stated behavior and never verifies the parent Decision; progress (completed/total) is derived and not stored.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "checked"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Trimmed authored Markdown after the checkbox marker, excluding any trailing anchor tail; unique within its Decision."
          },
          "checked": {
            "type": "boolean"
          },
          "anchors": {
            "type": "array",
            "description": "Author-declared evidence anchors parsed from the checkbox line's trailing ` — src: <path>::<symbol>[@<sha>]; test: <path>::<case>[@<sha>]; proof: <immutable blob URL>` tail, in authored order. Absent when the line has none. Anchors are identity only (path + symbol, optional pinned revision); line numbers and links are derived by `daq --resolve-anchors` and never stored. An anchor never checks a box or verifies behavior.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {
                  "enum": ["src", "test", "proof"]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Repository-relative file path (no leading `/`, `.` or `..` segments). An `<owner>/<repo>:` prefix names another repository; such anchors are reported unresolved."
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Rust `::` item path (`Enum::Variant`, `Type::method`, `module::item`), TypeScript `.` path (`Class.method`, `Namespace.member`), or a test case: a Rust `#[test]` fn item path or a TypeScript `describe > test` name."
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$",
                  "description": "Pinned commit for `src`/`test` (`@<sha>`); for `proof`, the commit of the immutable URL. Absent means the checkout's committed HEAD."
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/blob/[a-f0-9]{40}/",
                  "description": "Immutable GitHub blob URL; only on `proof` anchors. Recorded, never fetched."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "proof"
                      }
                    }
                  },
                  "then": {
                    "required": ["url", "revision"],
                    "not": {
                      "anyOf": [
                        {
                          "required": ["path"]
                        },
                        {
                          "required": ["symbol"]
                        }
                      ]
                    }
                  },
                  "else": {
                    "required": ["path", "symbol"],
                    "not": {
                      "required": ["url"]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "question"
          }
        }
      },
      "then": {
        "properties": {
          "decisionStatus": {
            "const": null
          },
          "choice": {
            "const": null
          },
          "evidence": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "properties": {
          "decisionStatus": {
            "enum": ["accepted", "recorded", "proposed", "superseded"]
          }
        }
      }
    }
  ]
}
