{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-tooling/benchmark-report.schema.json",
  "title": "coding-tooling benchmark report",
  "type": "object",
  "required": ["schemaVersion", "suite", "revision", "environment", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "required": ["os", "arch", "runtime", "runner"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string" }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "direction",
          "value",
          "sampleCount",
          "relativeRegressionPercent",
          "absoluteNoiseFloor"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["lower", "higher"] },
          "value": { "type": "number" },
          "sampleCount": { "type": "integer", "minimum": 2 },
          "relativeRegressionPercent": { "type": "number", "minimum": 0 },
          "absoluteNoiseFloor": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
