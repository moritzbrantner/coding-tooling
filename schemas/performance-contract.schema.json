{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-tooling/performance-contract.schema.json",
  "title": "coding-tooling performance contract",
  "type": "object",
  "required": ["schemaVersion", "suite", "scenarios"],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "description", "dimensions", "metrics"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": ["common", "idle", "scaling", "stress", "journey", "micro"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "correctnessEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "unit", "direction", "signal", "blocking"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": ["lower", "higher"]
                },
                "signal": {
                  "enum": [
                    "operation-count",
                    "allocation-count",
                    "instruction-count",
                    "cache-event-count",
                    "wall-clock",
                    "memory",
                    "size",
                    "throughput",
                    "custom"
                  ]
                },
                "blocking": {
                  "type": "boolean"
                },
                "budget": {
                  "type": "object",
                  "properties": {
                    "max": {
                      "type": "number"
                    },
                    "min": {
                      "type": "number"
                    },
                    "relativeRegressionPercent": {
                      "type": "number",
                      "minimum": 0
                    },
                    "absoluteNoiseFloor": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 1
                },
                "notes": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "blocking": {
                        "const": true
                      },
                      "signal": {
                        "const": "wall-clock"
                      }
                    },
                    "required": ["blocking", "signal"]
                  },
                  "then": {
                    "required": ["notes"]
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "description": "schemaVersion 2 only: operation-level work contracts verified by `coding-tooling performance work`.",
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "description", "dimensions", "scalePoints", "metrics"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "publicContract": {
            "type": "string",
            "minLength": 1
          },
          "dimensions": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "scalePoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "unit", "signal"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "signal": {
                  "enum": [
                    "operation-count",
                    "allocation-count",
                    "instruction-count",
                    "cache-event-count",
                    "memory",
                    "size",
                    "custom"
                  ]
                },
                "budget": {
                  "type": "object",
                  "required": ["max"],
                  "properties": {
                    "max": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "growth": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["dimension", "bound"],
                    "properties": {
                      "dimension": {
                        "type": "string",
                        "minLength": 1
                      },
                      "bound": {
                        "enum": ["constant", "linear"]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "notes": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "required": ["budget"]
                },
                {
                  "required": ["growth"],
                  "properties": {
                    "growth": {
                      "minItems": 1
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "not": {
          "required": ["operations"]
        }
      }
    }
  ],
  "$comment": "schemaVersion 1 contracts remain valid unchanged. schemaVersion 2 adds optional operations. Cross-field rules (growth dimensions are declared, scale points name exactly the declared dimensions and vary each bounded dimension) are enforced by src/performance-contract.ts."
}
