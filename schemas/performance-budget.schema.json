{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-tooling/performance-budget.schema.json",
  "title": "Lighthouse-compatible route budget",
  "type": "object",
  "required": ["schemaVersion", "sampleCount", "routes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sampleCount": { "type": "integer", "minimum": 3 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "budgets"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^/" },
          "budgets": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": ["direction", "limit"],
              "properties": {
                "direction": { "enum": ["minimum", "maximum"] },
                "limit": { "type": "number" },
                "relativeRegressionPercent": { "type": "number", "minimum": 0 },
                "absoluteNoiseFloor": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
