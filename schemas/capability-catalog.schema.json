{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coding-tooling/capability-catalog.schema.json",
  "title": "coding-tooling capability catalog",
  "type": "object",
  "required": ["schemaVersion", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "tier",
          "scriptCandidates",
          "defaultArtifacts",
          "optIn",
          "baselineRequired"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["static", "build", "test", "audit", "benchmark", "package"]
          },
          "tier": {
            "enum": ["fast", "focused", "integration", "system", "performance", "release"]
          },
          "scriptCandidates": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "defaultArtifacts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "optIn": { "type": "boolean" },
          "baselineRequired": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
