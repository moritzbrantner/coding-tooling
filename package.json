{
  "name": "coding-tooling",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": { "coding-tooling": "./src/cli.ts" },
  "scripts": {
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  },
  "engines": { "bun": ">=1.3.0" },
  "packageManager": "bun@1.3.14"
}
