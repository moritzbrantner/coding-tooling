{
  "name": "coding-tooling",
  "version": "0.2.0",
  "private": true,
  "bin": {
    "coding-tooling": "./src/entry.ts"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt --check .",
    "format:check": "oxfmt src/repository-score.ts tests/repository-score.test.ts && git diff -- src/repository-score.ts tests/repository-score.test.ts && exit 1",
    "format:write": "oxfmt .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "findings": "bun src/entry.ts findings --json",
    "score": "bun src/entry.ts score --json",
    "analyze": "bun src/entry.ts analyze --json",
    "calibration": "bun src/entry.ts calibration --json",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.0"
}
