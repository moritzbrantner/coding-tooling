{
  "name": "coding-tooling",
  "version": "0.2.0",
  "private": true,
  "bin": {
    "coding-tooling": "./src/router.ts"
  },
  "type": "module",
  "exports": {
    "./size-evidence": "./src/size-evidence.ts"
  },
  "scripts": {
    "format": "oxfmt --check .",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "findings": "bun src/entry.ts findings --json",
    "score": "bun src/entry.ts score --json",
    "analyze": "bun src/entry.ts analyze --json",
    "calibration": "bun src/entry.ts calibration --json",
    "normalize": "bun src/entry.ts normalize --json",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test",
    "analysis:worker:check": "bun test tests/analysis-worker-runtime.test.js",
    "analysis:worker:dev": "wrangler dev",
    "analysis:worker:deploy": "wrangler deploy",
    "analysis:worker:deploy:temporary": "wrangler deploy --temporary",
    "landscape:build": "bun scripts/build-landscape-snapshot.ts",
    "pages:build": "bun scripts/build-pages.ts",
    "pages:check": "bun scripts/check-pages.ts",
    "analysis:worker:bundle": "wrangler deploy --dry-run --outdir .artifacts/analysis-worker"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@typescript/typescript6": "6.0.2",
    "miniflare": "5.20260921.0-alpha",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "wrangler": "4.146.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.2"
}
